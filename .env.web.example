# Torp web API / frontend environment

# Session signing key (generate a long random string in production)
TORP_SESSION_SECRET=change-me-to-a-long-random-string

# Seeded only when the users table is empty
TORP_ADMIN_USER=admin
TORP_ADMIN_PASSWORD=admin

# Comma-separated origins allowed to call the API with cookies
TORP_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional override (default: sqlite under system_data/web_auth.db)
# TORP_DATABASE_URL=sqlite:///C:/path/to/web_auth.db

# Next.js rewrite target (used by web/next.config.ts)
TORP_API_URL=http://127.0.0.1:8000
